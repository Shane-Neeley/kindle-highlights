# Optional: unattended credential authentication.
# The safer default is interactive sign-in followed by saved-session reuse.
# AMAZON_EMAIL=your-email@example.com
# AMAZON_PASSWORD=your-password

# Optional: TOTP secret for unattended 2FA (base32 encoded)
# AMAZON_TOTP_SECRET=your-totp-secret

# Optional: Override where the exported highlights JSON is stored/read by the API
# HIGHLIGHTS_PATH=data/highlights.json

# Required only to enable POST /scrape in the service API.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# KINDLE_SCRAPE_API_TOKEN=replace-with-a-long-random-token
